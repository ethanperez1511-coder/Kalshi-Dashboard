KALSHI_API_KEY=
# Local: point to a .pem file
KALSHI_PRIVATE_KEY_PATH=kalshi_private.pem
# Cloud (Railway): paste PEM contents directly as an env var instead
KALSHI_PRIVATE_KEY=
ODDS_API_KEY=
# Local default
DATABASE_URL=sqlite:///kalshi.db
# Railway: set this to sqlite:////data/kalshi.db (four slashes = absolute path)
