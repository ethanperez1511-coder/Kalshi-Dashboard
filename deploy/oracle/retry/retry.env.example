# Copy to retry.env (git-ignored) and fill in. No secrets here: OCIDs are
# identifiers, and the SSH key referenced is the PUBLIC one.
COMPARTMENT_OCID=ocid1.compartment.oc1..xxxx
SUBNET_OCID=ocid1.subnet.oc1.iad.xxxx
SSH_PUBLIC_KEY_FILE=$HOME/.ssh/oci_kalshi.pub
DISPLAY_NAME=kalshi-paper
OCPUS=1
MEMORY_GB=6
BOOT_GB=100
SLEEP_SECONDS=90
